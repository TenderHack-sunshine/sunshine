# All paths are relative to the repository root unless absolute.
DATA_DIR=data
MODEL_DIR=models
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=zakupki_knowledge
QDRANT_OFFICIAL_COLLECTION=zakupki_official
# Fail over to lightweight official BM25 if one dense query takes longer.
DENSE_QUERY_TIMEOUT_SECONDS=12
DENSE_WORKER_HOST=127.0.0.1
DENSE_WORKER_PORT=8765
OFFICIAL_EXPECTED_POINTS=1073
RERANK_ENABLED=0
# Preferred name; RERANK_ENABLED remains supported for compatibility.
RERANKER_ENABLED=0
HYBRID_RERANK_TOP_N=20
# Dense is the validated primary ranking path. Hybrid RRF remains available
# for experiments; BM25 is a sparse rescue and dense-unavailable fallback.
RETRIEVAL_STRATEGY=dense_primary
DENSE_PRIMARY_MIN_SCORE=0.55
DENSE_PRIMARY_MIN_AGREEMENT=0.0
DENSE_PRIMARY_KEEP_TOP_K=3
BM25_RESCUE_TOP_K=3
EVIDENCE_MAX_PER_DOCUMENT=2
CONFIDENCE_MIN_SOURCES=1
CONFIDENCE_MIN_OFFICIAL_SCORE=0.0
CONFIDENCE_MIN_AGREEMENT=0.0
# Weighted RRF. Defaults preserve the original equal-weight fusion.
RRF_K=60
DENSE_FUSION_WEIGHT=1.0
BM25_FUSION_WEIGHT=1.0
OFFICIAL_RRF_WEIGHT=1.0
TICKET_RRF_WEIGHT=1.0
# Set to 1 only when a local Qdrant server is already running.
USE_QDRANT=1
RAG_HOST=0.0.0.0
RAG_PORT=8000
SEMANTIC_CHUNKING_ENABLED=1
SEMANTIC_BREAKPOINT_PERCENTILE=85
MIN_CHUNK_TOKENS=100
TARGET_CHUNK_TOKENS=300
MAX_CHUNK_TOKENS=500
FORCED_SPLIT_OVERLAP_TOKENS=50
# Set this to the verified structured Knowledge Base API endpoint; it is deliberately not guessed in code.
ZAKUPKI_KB_API_URL=
ZAKUPKI_KB_BASE_URL=https://zakupki.mos.ru
ZAKUPKI_KB_SECTION_TYPES=supplier
ZAKUPKI_KB_TIMEOUT_SECONDS=20
ZAKUPKI_KB_MAX_RETRIES=3
ZAKUPKI_KB_MAX_CHUNK_TOKENS=700
