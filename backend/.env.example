PORT=8080
API_HOST_PORT=8081
DATABASE_URL=postgres://sunshine:sunshine@localhost:5432/sunshine?sslmode=disable
RAG_SERVICE_URL=http://localhost:8000
RAG_SERVICE_TIMEOUT=30s

# Authentication. JWT_SECRET must be at least 32 random characters
# (e.g. `openssl rand -base64 48`) — generate a real one per environment,
# never reuse this placeholder.
JWT_SECRET=change-me-to-a-random-32-plus-character-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
# Origin of the frontend dev server / deployment, used for CORS + cookies.
FRONTEND_ORIGIN=http://localhost:5173
# true once served over HTTPS; keep false for local http:// development.
COOKIE_SECURE=false

# Optional: when both are set, the API ensures this account exists with the
# admin role on startup, so there's always at least one admin able to
# approve tech specialists and grant roles.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-strong-password
ADMIN_DISPLAY_NAME=Администратор
